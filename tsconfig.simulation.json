{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "/tmp/evera-sim-build",
    "rootDir": "src"
  },
  "include": [
    "src/types/**/*.ts",
    "src/simulation/**/*.ts",
    "src/persistence/migrate.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
